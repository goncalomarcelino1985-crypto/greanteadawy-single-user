# Copy to .env (or export the variables) to configure the server. Everything is optional.
# Docker Compose reads the same file (see docs/docker.md); there HOST/PORT/DATA_DIR are fixed and GTD_PORT sets the port.

# --- network
PORT=3001
HOST=127.0.0.1                 # keep this behind a reverse proxy on the same machine; 0.0.0.0 = all interfaces (Docker, LAN)
# PUBLIC_URL=https://beats.example.com     # external URL: download links for Claude, allowed browser Origin.
#                                          # Always set it behind a reverse proxy (turns off "local" trust).
# ALLOWED_HOSTS=beats.example.com          # Host header allow-list (default: localhost names on loopback; "*" = off)
# TRUST_PROXY=1                            # behind a reverse proxy: number of proxy hops (avoid "true")

# --- storage
# DATA_DIR=./data              # projects, versions, samples, exports, accounts (relative to the repository root)
# MAX_UPLOAD_MB=50             # max sample upload size

# --- accounts
# SESSION_TTL_DAYS=30          # sign-in lifetime (sliding)
# SETUP_CODE=choose-a-secret   # first-run admin setup code for remote/proxied setup (default: random, printed in the log)

# --- audio export (MP3, AAC, Ogg, Opus, FLAC, Apple Lossless, AIFF need ffmpeg on the server; WAV never does)
# FFMPEG_PATH=/usr/bin/ffmpeg  # default: "ffmpeg" on the PATH; "off" disables conversions
# FFMPEG_TIMEOUT_SEC=300       # a conversion taking longer is stopped
# FFMPEG_MAX_JOBS=2            # conversions running at the same time (more wait their turn)

# --- plugins (users' own instruments, effects and note generators; sandboxed in the browser)
# PLUGINS_ENABLED=true         # false = nobody can install or use plugins (admins can also switch them off in Settings → Server)

# --- Docker Compose only
# GTD_PORT=3001                # port published on this computer (127.0.0.1)
# DOMAIN=beats.example.com     # with `docker compose --profile proxy up -d`: Caddy gets an HTTPS certificate for it

# --- MCP
# MCP_TOKEN=change-me          # legacy shared token acting as the first admin; when set, token-less MCP is disabled.
#                              # Prefer personal tokens: Settings → API & MCP in the studio.

# --- stdio MCP bridge (server/src/mcp/stdio.js, e.g. from Claude Desktop)
# GREANTEADAWY_URL=http://127.0.0.1:3001   # where the web server runs (also used by the Vite dev proxy)
# GREANTEADAWY_TOKEN=gtd_xxxxxx_...        # your personal API token

# Personal studio mode (see docs/single-user.md)
# SINGLE_USER=true
# PRIVATE_ACCESS_KEY=<32 random bytes encoded as base64url; never commit>
# EPHEMERAL_STORAGE=true
