{
  "id": "yourname.my-generator",
  "name": "My Generator",
  "version": "1.0.0",
  "type": "generator",
  "author": "Your Name",
  "description": "Writes an arpeggio in the project's scale over the pattern.",
  "license": "MIT",
  "apiVersion": 1,
  "main": "generator.js",
  "permissions": ["generator"],
  "params": [
    { "key": "rate", "label": "Rate", "type": "select", "options": ["8th", "16th"], "default": "16th" },
    { "key": "range", "label": "Octaves", "min": 1, "max": 3, "default": 2, "step": 1 },
    { "key": "direction", "label": "Direction", "type": "select", "options": ["up", "down", "updown", "random"], "default": "up" },
    { "key": "velocity", "label": "Velocity", "min": 0.1, "max": 1, "default": 0.75 },
    { "key": "gate", "label": "Gate", "min": 0.1, "max": 1, "default": 0.8 }
  ],
  "presets": { "Default": {}, "Wide Up-Down": { "range": 3, "direction": "updown" }, "Sparkle": { "rate": "16th", "direction": "random", "velocity": 0.6 } }
}
