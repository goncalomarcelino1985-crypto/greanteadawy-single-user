{
  "id": "greanteadawy.chiptune",
  "name": "Chiptune",
  "version": "1.0.0",
  "type": "instrument",
  "author": "GreanTeaDawy examples",
  "description": "A band-limited pulse-wave voice (12.5 / 25 / 50 % duty) with a stepped 8-bit volume envelope and delayed vibrato — classic console leads, arps and square basses.",
  "license": "MIT",
  "apiVersion": 1,
  "main": "dsp.js",
  "permissions": ["audio-processing"],
  "color": "#5ab8f0",
  "polyphony": 8,
  "params": [
    { "key": "duty", "label": "Duty", "type": "select", "options": ["12.5%", "25%", "50%"], "default": "50%" },
    { "key": "gain", "label": "Gain", "min": 0, "max": 1, "default": 0.45 },
    { "key": "attack", "label": "Attack", "min": 0.001, "max": 1, "default": 0.004, "curve": "log", "unit": "s", "group": "Envelope" },
    { "key": "decay", "label": "Decay", "min": 0.01, "max": 2, "default": 0.25, "curve": "log", "unit": "s", "group": "Envelope" },
    { "key": "sustain", "label": "Sustain", "min": 0, "max": 1, "default": 0.6, "group": "Envelope" },
    { "key": "release", "label": "Release", "min": 0.005, "max": 2, "default": 0.12, "curve": "log", "unit": "s", "group": "Envelope" },
    { "key": "vibrato", "label": "Vibrato", "min": 0, "max": 60, "default": 12, "unit": "ct", "group": "Vibrato" },
    { "key": "vibratoRate", "label": "Rate", "min": 1, "max": 12, "default": 6, "unit": "Hz", "group": "Vibrato" },
    { "key": "steps", "label": "8-bit volume", "type": "bool", "default": true }
  ],
  "presets": {
    "Square Lead": {},
    "Thin Lead": { "duty": "12.5%", "vibrato": 18 },
    "Square Bass": { "duty": "50%", "vibrato": 0, "sustain": 0.9, "release": 0.04, "gain": 0.55 },
    "Arp": { "duty": "25%", "decay": 0.08, "sustain": 0.15, "vibrato": 0, "release": 0.05 }
  }
}
