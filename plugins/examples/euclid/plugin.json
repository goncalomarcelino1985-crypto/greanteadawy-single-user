{
  "id": "greanteadawy.euclid",
  "name": "Euclidean Rhythms",
  "version": "1.0.0",
  "type": "generator",
  "author": "GreanTeaDawy examples",
  "description": "Spreads N hits as evenly as possible over a cycle of steps (Bjorklund/Euclid), with rotation, an accent on the cycle's first hit and gentle velocity humanizing. 3/8 = tresillo, 5/8 = cinquillo, 7/16 = samba-ish.",
  "license": "MIT",
  "apiVersion": 1,
  "main": "generator.js",
  "permissions": ["generator"],
  "params": [
    { "key": "pulses", "label": "Hits", "min": 1, "max": 32, "default": 3, "step": 1 },
    { "key": "cycle", "label": "Cycle", "min": 2, "max": 32, "default": 8, "step": 1, "unit": "steps" },
    { "key": "rotate", "label": "Rotate", "min": 0, "max": 31, "default": 0, "step": 1 },
    { "key": "velocity", "label": "Velocity", "min": 0.1, "max": 1, "default": 0.75 },
    { "key": "accent", "label": "Accent", "min": 0, "max": 0.5, "default": 0.2 },
    { "key": "humanize", "label": "Humanize", "min": 0, "max": 0.3, "default": 0.05 },
    { "key": "gate", "label": "Note length", "min": 0.25, "max": 4, "default": 1, "unit": "steps" }
  ],
  "presets": {
    "Tresillo 3/8": {},
    "Cinquillo 5/8": { "pulses": 5, "rotate": 6 },
    "Samba 7/16": { "pulses": 7, "cycle": 16 },
    "Bossa 5/16": { "pulses": 5, "cycle": 16, "rotate": 6 }
  }
}
